# ============================================================================
# DateTon - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ============================================================================


# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Connection string for your MongoDB Atlas cluster (or local instance).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Name of the database to use within the MongoDB cluster.
MONGODB_DB_NAME=DateTon


# ─── Message Encryption ─────────────────────────────────────────────────────
# AES-256 key used to encrypt/decrypt chat messages at rest.
# Generate one with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=


# ─── Cloudinary (Image Uploads) ─────────────────────────────────────────────
# Used for storing user profile photos.
# Get your credentials at: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Full Cloudinary URL (alternative auth method used by some SDKs).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=


# ─── TON Blockchain ─────────────────────────────────────────────────────────
# Network to use: "testnet" for development, "mainnet" for production.
TON_NETWORK=testnet

# Platform wallet address that receives fees (deploy fee, boost payments, etc.).
# This is the same address exposed to the frontend for transaction building.
PAYMENT_ADDRESS=
NEXT_PUBLIC_PAYMENT_ADDRESS=
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=

# Address of the Jetton master contract (if using custom tokens).
JETTON_MASTER_ADDRESS=

# URL of the facilitator API endpoint used for escrow contract deployment.
# Use your own deployment URL or localhost for local development.
# FACILITATOR_URL=http://localhost:3000/api/facilitator
FACILITATOR_URL=

# TON RPC endpoint for reading on-chain state and verifying transactions.
# Testnet: https://testnet.toncenter.com/api/v2/jsonRPC
# Mainnet: https://toncenter.com/api/v2/jsonRPC
TON_RPC_URL=https://testnet.toncenter.com/api/v2/jsonRPC

# API key for the TON RPC provider (get one at https://toncenter.com).
RPC_API_KEY=

# 24-word mnemonic of the server wallet used to deploy escrow contracts.
# Keep this secret! Never commit it to version control.
WALLET_MNEMONIC=""


# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather, used to send notifications to users.
# Create a bot at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=


# ─── App URL ─────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used for generating callback URLs).
# For local development: http://localhost:3000
# For production: your Vercel/deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
