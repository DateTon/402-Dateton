{
  "name": "ton-x402",
  "version": "0.1.0",
  "private": true,
  "description": "x402 (HTTP 402 Payment Required) protocol implementation for TON blockchain",
  "workspaces": [
    "packages/*",
    "datetonapp"
  ],
  "scripts": {
    "dev": "pnpm --filter datetonapp dev",
    "start": "pnpm --filter datetonapp start",
    "build": "pnpm --filter './packages/**' -r build",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@ton-community/assets-sdk": "^0.0.5",
    "uuid": "^13.0.0"
  }
}